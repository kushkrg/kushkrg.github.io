---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lavkush Kumar — Full Stack Web Developer (React, Next.js, PHP, MERN)',
  description = 'Full Stack Web Developer specialising in React, Next.js, PHP and the MERN stack. Marketing Web Developer at CS DISCO and creator of Coding Cush, a free programming-education platform with a YouTube channel and the CodingCush.com blog.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lavkush Kumar',
  url: 'https://lavkushkumar.com/',
  jobTitle: 'Full Stack Web Developer',
  worksFor: { '@type': 'Organization', name: 'CS DISCO' },
  address: { '@type': 'PostalAddress', addressLocality: 'Delhi', addressCountry: 'IN' },
  email: 'mailto:hello@lavkushkumar.com',
  sameAs: [
    'https://github.com/kushkrg',
    'https://www.linkedin.com/in/kushkrg/',
    'https://x.com/kushkrg',
    'https://www.instagram.com/codingcush',
    'https://www.youtube.com/@CodingCush',
    'https://codingcush.com',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('lk-theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch (e) {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="author" content="Lavkush Kumar" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <slot name="head" />
  </head>
  <body>
    <div id="cursorGlow" aria-hidden="true"></div>
    <header class="site">
      <div class="wrap nav">
        <a class="logo" href="#top">Lavkush<span>.</span></a>
        <div class="nav-right">
          <button id="themeToggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          </button>
          <button class="nav-toggle" aria-label="Menu" id="navToggle">☰</button>
        </div>
        <ul class="nav-links" id="navLinks">
          <li><a href="#about">About</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#pricing">Pricing</a></li>
          <li><a class="nav-cta" href="#contact">Hire Me</a></li>
        </ul>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>© <span id="year">2026</span> Lavkush Kumar. Built with Astro.</span>
        <span>Delhi, India · <a href="https://lavkushkumar.com">lavkushkumar.com</a></span>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      toggle?.addEventListener('click', () => links?.classList.toggle('open'));
      links?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => links.classList.remove('open'))
      );

      const themeBtn = document.getElementById('themeToggle');
      themeBtn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('lk-theme', next);
        } catch (e) {}
      });

      const year = document.getElementById('year');
      if (year) year.textContent = String(new Date().getFullYear());

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        gsap.registerPlugin(ScrollTrigger);

        // Infinite tech marquee
        const track = document.querySelector('.marquee-track');
        if (track) {
          gsap.to(track, { xPercent: -50, duration: 28, ease: 'none', repeat: -1 });
        }

        // Experience timeline — staggered slide-in
        const tItems = document.querySelectorAll('.t-item');
        if (tItems.length) {
          gsap.fromTo(
            tItems,
            { x: -30, opacity: 0 },
            {
              x: 0,
              opacity: 1,
              duration: 0.85,
              ease: 'power3.out',
              stagger: 0.15,
              scrollTrigger: { trigger: '.timeline', start: 'top 78%', once: true },
            }
          );
        }

        // Section titles — gentle parallax rise
        document.querySelectorAll('.section-title').forEach((el) => {
          gsap.fromTo(
            el,
            { y: 36 },
            {
              y: 0,
              duration: 1,
              ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            }
          );
        });

        // Header gains a shadow after scrolling a little
        const header = document.querySelector('header.site');
        ScrollTrigger.create({
          start: 30,
          onToggle: (self) => header?.classList.toggle('scrolled', self.isActive),
        });

        if (window.matchMedia('(pointer: fine)').matches) {
          // 3D tilt on cards
          document.querySelectorAll('.card').forEach((card) => {
            const el = card as HTMLElement;
            el.addEventListener('mousemove', (e) => {
              const r = el.getBoundingClientRect();
              const rotateX = ((e.clientY - r.top) / r.height - 0.5) * -7;
              const rotateY = ((e.clientX - r.left) / r.width - 0.5) * 7;
              gsap.to(el, {
                rotateX,
                rotateY,
                transformPerspective: 900,
                duration: 0.5,
                ease: 'power2.out',
              });
            });
            el.addEventListener('mouseleave', () => {
              gsap.to(el, { rotateX: 0, rotateY: 0, duration: 0.8, ease: 'elastic.out(1, 0.5)' });
            });
          });

          // Ambient cursor glow
          const glow = document.getElementById('cursorGlow');
          if (glow) {
            gsap.set(glow, { xPercent: -50, yPercent: -50, x: -600, y: -600 });
            const qx = gsap.quickTo(glow, 'x', { duration: 0.6, ease: 'power3' });
            const qy = gsap.quickTo(glow, 'y', { duration: 0.6, ease: 'power3' });
            window.addEventListener('mousemove', (e) => {
              qx(e.clientX);
              qy(e.clientY);
            });
          }
        }
      }
    </script>
  </body>
</html>
